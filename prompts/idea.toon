  stateful_to_stateless_guide_md:
    _text: STATEFUL_TO_STATELESS_GUIDE.md
stateful_to_stateless_migration_guide:
  _text: "Stateful to Stateless Migration Guide"
  current_state__mostly_stateful__:
    _text: "Current State: MOSTLY STATEFUL ❌"
    paragraphs[1]: "The system has significant in-memory state that is **lost on server restart, deployment, or when scaling to multiple instances**."
  ___stateful_components_analysis:
    _text: "📊 Stateful Components Analysis"
    1____conversation_storage______conditionally_stateless:
      _text: "1. **Conversation Storage** ⚠️ CONDITIONALLY STATELESS"
      paragraphs[4]: "**Current Implementation:**", "**Location:** `web/src/lib/mill/conversation-store.ts`", "**What's Stored:**", "**Impact of Loss:**"
      lists[3]{0,1}:
        "**With Redis**: Stateless (1-hour TTL, shared across instances)","**Without Redis**: Stateful (in-memory Map, lost on restart)"
        "`activeAgent`: Which agent is handling the conversation (mill/chatur/sera)","`millSessionId`, `chaturSessionId`, `seraSessionId`: Session identifiers"
        "Users lose conversation context","Must restart conversation from scratch"
    2____agent_sessions_____stateful:
      _text: "2. **Agent Sessions** ❌ STATEFUL"
      paragraphs[4]: "**Location:** `web/src/runtime/shared/base-agent.ts`", "**Affects:**", "**What's Stored:**", "**Impact of Loss:**"
      lists[3]{0,1,2}:
        "Mill (transaction logging agent)","Chatur (coaching agent)","Sera (shopping agent)"
        "Session ID → Session state mapping","Current conversation step","Pending data (forms, queries, etc.)"
        "Users lose partial conversation progress","Incomplete transactions get dropped","Agent loses context mid-conversation"
    3____alert_manager_cache_____stateful:
      _text: "3. **Alert Manager Cache** ❌ STATEFUL"
      paragraphs[3]: "**Location:** `web/src/runtime/dev/alert-manager.ts`", "**What's Stored:**", "**Impact of Loss:**"
      lists[2]{0,1,2}:
        "Alert deduplication signatures","Alert count per signature","Event listeners for real-time notifications"
        "Duplicate alerts may be created","Alert rate limiting breaks","Real-time listeners disconnected"
    4____categorization_cache_____stateful:
      _text: "4. **Categorization Cache** ❌ STATEFUL"
      paragraphs[3]: "**Location:** `web/src/runtime/shared/categorization-cache.ts`", "**What's Stored:**", "**Impact of Loss:**"
      lists[2]{0,1,2}:
        "Transaction description → Category mapping","LLM categorization results","Cache timestamps for TTL"
        "Repeated LLM calls for same transactions","Increased API costs","Slower transaction processing"
    5____circuit_breakers_____stateful:
      _text: "5. **Circuit Breakers** ❌ STATEFUL"
      paragraphs[3]: "**Location:** `web/src/runtime/shared/error-handling.ts`", "**What's Stored:**", "**Impact of Loss:**"
      lists[2]{0,1,2}:
        "LLM service failure counts","Circuit breaker states (OPEN/CLOSED)","Last reset timestamps"
        "Circuit breakers reset on restart","May call failing services unnecessarily","No shared state across instances"
    6____mutex_locks_____stateful:
      _text: "6. **Mutex Locks** ❌ STATEFUL"
      paragraphs[3]: "**Location:** `web/src/runtime/shared/mutex.ts`", "**What's Stored:**", "**Impact of Loss:**"
      lists[2]{0,1}:
        "Transaction ID → Lock promise mapping","Prevents concurrent processing of same transaction"
        "Race conditions possible on restart","No distributed locking across instances"
  __already_stateless_components:
    _text: "✅ Already Stateless Components"
    paragraphs[1]: "These are properly stored in PostgreSQL and are stateless:"
    lists[1]{0,1,2,3,4,5}:
      "**Transactions** → `tranasctions` table","**Alerts** → `alerts` table (creation is persistent, cache is not)","**Habit Insights** → `habit_insights` table","**Coach Briefings** → `coach_briefings` table","**Shopping Wishlist** → `shopping_wishlist` table","**SMS Messages** → `sms_messages` table"
  ___migration_plan__make_everything_stateless:
    _text: "🎯 Migration Plan: Make Everything Stateless"
    __option_a__redis_only_approach____fast__no_schema_changes_:
      _text: "**Option A: Redis-Only Approach** (Fast, No Schema Changes)"
      paragraphs[2]: "**Advantages:**", "**Disadvantages:**"
      lists[2]{0,1,2,3}:
        "No database schema changes needed","Fast read/write performance","TTL/expiry built-in","Already partially implemented"
        "Data lost if Redis crashes (unless using Redis persistence)","No long-term analytics possible","Additional infrastructure dependency",null
      implementation_steps_:
        _text: "Implementation Steps:"
        lists[1]{0,1,2,3,4,5}:
          "**Conversations** ✅ Already Supported

```bash
# Set environment variable
REDIS_URL=redis://localhost:6379
# or
UPSTASH_REDIS_URL=your-upstash-url
```","**Agent Sessions** → Store in Redis

```typescript
// Key: session:{sessionId}
// Value: JSON-serialized session state
// TTL: 1 hour
await redis.set(`session:${sessionId}`, JSON.stringify(session), {
  EX: 3600,
});
```","**Alert Cache** → Store in Redis

```typescript
// Key: alert:sig:{hash}
// Value: { count, timestamp }
// TTL: 5 minutes
await redis.set(`alert:sig:${hash}`, JSON.stringify({ count, timestamp }), {
  EX: 300,
});
```","**Categorization Cache** → Store in Redis

```typescript
// Key: cat:{descHash}
// Value: { category, subcategory }
// TTL: 24 hours
await redis.set(`cat:${hash}`, JSON.stringify(result), {
  EX: 86400,
});
```","**Circuit Breakers** → Store in Redis

```typescript
// Key: cb:{serviceName}
// Value: { state, failureCount, lastReset }
// TTL: 1 hour
await redis.set(`cb:${service}`, JSON.stringify(state), {
  EX: 3600,
});
```","**Mutex Locks** → Redis Distributed Lock
```typescript
// Use Redlock algorithm
const lock = await redlock.acquire([`lock:tx:${txId}`], 5000);
try {
  // Process transaction
} finally {
  await lock.release();
}
```"
    __option_b__database_first_approach____recommended_for_production_:
      _text: "**Option B: Database-First Approach** (Recommended for Production)"
      paragraphs[2]: "**Advantages:**", "**Disadvantages:**"
      lists[2]{0,1,2,3,4}:
        "Permanent storage, no data loss","Long-term analytics possible","Query conversations for insights","No additional infrastructure (PostgreSQL already exists)","Audit trail and compliance"
        "Database schema changes required","Slightly slower than Redis for high-frequency reads","More disk space usage",null,null
      implementation_steps_:
        _text: "Implementation Steps:"
      1____create_conversation_tables__:
        _text: "1. **Create Conversation Tables**"
        paragraphs[1]: "Add to `data/schema.prisma`:"
      2____update_conversation_store_implementation__:
        _text: "2. **Update Conversation Store Implementation**"
        paragraphs[1]: "Create `web/src/lib/mill/database-conversation-store.ts`:"
      3____update_conversation_store_ts__:
        _text: "3. **Update conversation-store.ts**"
      4____add_cleanup_job__:
        _text: "4. **Add Cleanup Job**"
        paragraphs[1]: "Create `web/src/app/api/cleanup/conversations/route.ts`:"
    __option_c__hybrid_approach____best_of_both_worlds_:
      _text: "**Option C: Hybrid Approach** (Best of Both Worlds)"
      paragraphs[2]: "Use **Redis for hot data** and **PostgreSQL for cold storage**:", "**Implementation:**"
      lists[2]{0,1,2,3}:
        "**Active conversations** → Redis (fast access, 1-hour TTL)","**Expired conversations** → Archive to PostgreSQL (analytics, compliance)","**Caches** → Redis (fast, ephemeral)","**Audit trail** → PostgreSQL (permanent record)"
        "Write to both Redis and PostgreSQL","Read from Redis first, fallback to PostgreSQL","Archive expired Redis data to PostgreSQL periodically",null
  ___recommended_implementation_order:
    _text: "🚀 Recommended Implementation Order"
    phase_1__quick_wins__1_2_days_:
      _text: "Phase 1: Quick Wins (1-2 days)"
      lists[1]{0,1,2,3}:
        "✅ Configure REDIS_URL (already supported)","Move alert cache to Redis","Move categorization cache to Redis","Move circuit breakers to Redis"
    phase_2__core_functionality__3_5_days_:
      _text: "Phase 2: Core Functionality (3-5 days)"
      lists[1]{0,1,2,3}:
        "Create database schema for conversations","Implement DatabaseConversationStore","Add cleanup cron jobs","Testing and validation"
    phase_3__advanced_features__5_7_days_:
      _text: "Phase 3: Advanced Features (5-7 days)"
      lists[1]{0,1,2,3}:
        "Implement distributed locks (Redis or PostgreSQL)","Add conversation analytics queries","Implement hybrid approach (Redis + PostgreSQL)","Add monitoring and alerting"
  ___performance_considerations:
    _text: "📈 Performance Considerations"
    redis__fast_:
      _text: "Redis (Fast)"
      lists[1]{0,1,2}:
        "**Read latency**: 1-5ms","**Write latency**: 1-5ms","**Best for**: High-frequency operations"
    postgresql__durable_:
      _text: "PostgreSQL (Durable)"
      lists[1]{0,1,2}:
        "**Read latency**: 5-20ms (with indexes)","**Write latency**: 10-50ms","**Best for**: Permanent storage, complex queries"
    recommendation_:
      _text: "Recommendation:"
      lists[1]{0,1,2}:
        "Use **Redis** for active sessions and caches","Use **PostgreSQL** for conversation history and analytics","Hybrid approach for production systems"
  __testing_checklist:
    _text: "✅ Testing Checklist"
    lists[1]{0,1,2,3,4,5}:
      "Conversations survive server restart","Multiple instances share state correctly","No race conditions in distributed locks","Cleanup jobs remove expired data","Metrics show no data loss","Performance meets SLA (<100ms p95)"
  ___monitoring:
    _text: "🔍 Monitoring"
    paragraphs[1]: "Key metrics to track:"
    lists[1]{0,1,2,3,4,5}:
      "Conversation session count","Average session duration","Cache hit rates","Database query latency","Redis memory usage","Cleanup job success rate"
  ___environment_variables:
    _text: "📝 Environment Variables"
  ___success_criteria:
    _text: "🎯 Success Criteria"
    paragraphs[1]: "A stateless system should:"
    lists[1]{0,1,2,3,4,5}:
      "✅ Survive server restarts without data loss","✅ Scale horizontally across multiple instances","✅ Share state consistently across instances","✅ Handle failures gracefully","✅ Provide audit trail for compliance","✅ Support analytics and insights"
