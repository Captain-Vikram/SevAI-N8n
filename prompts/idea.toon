      lists[1]{0,1,2,3}:
        "✅ Search results match user needs","✅ Price comparisons accurate","✅ Product recommendations within budget","✅ Conversational flow smooth and natural"
  best_practices:
    _text: "Best Practices"
    for_developers:
      _text: "For Developers"
      lists[1]{0,1,2,3,4}:
        "**Confirm before search**: Always wait for user's \"yes\"","**Budget first**: Ask price range before searching","**Accurate data**: Use exact product details from search results","**API resilience**: Handle SerpAPI failures gracefully","**Respect boundaries**: Redirect non-shopping questions"
    for_users:
      _text: "For Users"
      lists[1]{0,1,2,3,4}:
        "**Share budget**: Helps Sera find right options","**Be specific**: \"Gaming laptop\" > \"laptop\"","**Ask questions**: Sera loves explaining specs","**Use wishlist**: Save items you're considering","**Check with Chatur**: Get budget approval before big purchases"
