        lists[1]{0,1,2}:
          "\"How much should I save daily to reach X?\"","\"Save ₹200 per month, how much daily?\"","\"Reach ₹10,000 in 6 months\""
      2__daily_budget_calculator:
        _text: "2. Daily Budget Calculator"
        paragraphs[5]: "**Purpose**: Calculate daily spending budget based on income, fixed expenses, and savings goals", "**Function**: `calculateDailyBudget(monthlyIncome, fixedExpenses, savingsGoal)`", "**Returns**:", "**Example**:", "**Triggers on**:"
        lists[1]{0,1,2}:
          "\"How much can I spend daily?\"","\"What's my daily budget?\"","\"Spending limit if I save ₹4,000/month\""
