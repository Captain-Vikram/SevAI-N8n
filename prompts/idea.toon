      2_2_different_format:
        _text: "2.2 Different Format"
      2_3_with_rupee_symbol:
        _text: "2.3 With Rupee Symbol"
      2_4_decimal_amount:
        _text: "2.4 Decimal Amount"
        paragraphs[1]: "**Verification:**"
        lists[1]{0,1,2}:
          "Open `data/transactions.csv`","Count new entries (should be 4)","Check amounts, categories, descriptions match"
    scenario_3__income_logging__10_minutes_:
      _text: "SCENARIO 3: Income Logging (10 minutes)"
      paragraphs[2]: "**Objective:** Test income detection and logging", "**Test Cases:**"
      3_1_client_payment:
        _text: "3.1 Client Payment"
      3_2_different_verbs:
        _text: "3.2 Different Verbs"
      3_3_mixed_format:
        _text: "3.3 Mixed Format"
        paragraphs[1]: "**Verification:**"
        lists[1]{0,1,2}:
          "Check `data/transactions.csv`","Filter for `direction = \"income\"`","Verify 3 new income entries"
    scenario_4__query_transactions__15_minutes_____critical_test:
      _text: "SCENARIO 4: Query Transactions (15 minutes) ⚠️ CRITICAL TEST"
      paragraphs[2]: "**Objective:** Verify Mill ACTUALLY calls query_spending_summary tool (not just text)", "**Test Cases:**"
      4_1_summary_request:
        _text: "4.1 Summary Request"
      4_2_recent_transactions:
        _text: "4.2 Recent Transactions"
      4_3_alternative_phrasing:
        _text: "4.3 Alternative Phrasing"
      4_4_transaction_history:
        _text: "4.4 Transaction History"
        paragraphs[2]: "**Debugging:**
If Mill responds with text like \"let me fetch that\" but NO DATA:", "**Success Indicators:**"
