  ___quick_start_guide:
    _text: "📖 Quick Start Guide"
    for_users:
      _text: "For Users"
      paragraphs[2]: "Just ask natural questions:", "Chatur will automatically detect, calculate, and explain!"
    for_developers:
      _text: "For Developers"
      paragraphs[3]: "**Run calculations**:", "**Test suite**:", "**Documentation**:"
      lists[1]{0,1,2}:
        "Full API: `docs/FINANCIAL_CALCULATOR.md`","Integration: `docs/CHATUR_ARCHITECTURE.md`","Tools reference: `docs/AGENT_TOOLS_REFERENCE.md`"
  ___impact:
