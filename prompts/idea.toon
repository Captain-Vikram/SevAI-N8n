project: Sevai - agentic finance assistant (Telegram + n8n + Google Sheets)
direction: LR

replaced[7]{old,new}:
  PostgreSQL + Prisma,Google Sheets (user-connected sheet = personal database)
  WhatsApp + Twilio/Meta,Telegram Bot
  POST /api/whatsapp/webhook,n8n Telegram Trigger
  POST /api/agent + ConversationRouter,n8n Switch node (intent routing)
  Redis / in-memory conversation store,n8n chat memory keyed by chat_id
  Cron endpoints,n8n Schedule Trigger
  Circuit breaker + retry,n8n Retry On Fail + Error Workflow

nodes[46]{id,label,group}:
  user,End User,actor
  tg,Telegram Bot,channel
  android,Opt-in Android App (on-device SMS filter),app
  dash,Temporary Interactive Dashboard (expiring link),app
  onboard,n8n Onboarding - consent + Google OAuth + pick sheet,n8n
  tg_trigger,n8n Telegram Trigger,n8n
  sms_hook,n8n Webhook (filtered SMS in),n8n
  router,n8n Switch - intent routing,n8n
  memory,n8n Chat Memory (per chat_id),state
  mill,Mill - Telegram chatbot and gateway,agent
  dev,Dev - parser and transaction classifier,agent
  param,Param - Analyst (patterns and user type),agent
  chatur,Chatur - Financial Advisor and future-buy planner,agent
  sera,Sera - Search Agent (budget + product search),agent
  pricewatch,Price Tracker - price history and wishlist,agent
  invest,Investment Tracker - holdings and net worth,agent
  risk,Risk Monitor - anomaly check on new transactions,agent
  sms_cron,n8n Schedule Trigger - SMS queue,job
  param_cron,n8n Schedule Trigger - nightly analyst,job
  price_cron,n8n Schedule Trigger - price checks,job
  stock_cron,n8n Schedule Trigger - market checks,job
  valid,Valid completed transaction?,decision
  complete,Vendor and purpose present?,decision
  classify,Category classification (travel/food/luxury/electronics/clothes),step
  unusual,Unusual or large spending?,decision
  target_hit,Price at or near user target?,decision
  stock_drop,Holding dropped over threshold?,decision
  drop,Rejected as null (OTP / marketing / balance / failed),sink
  calc,Financial Calculator (Code node),tool
  analyzer,Expense Analyzer + Decision Tools (Code node),tool
  retry,n8n Retry On Fail + Error Workflow,infra
  tg_send,n8n Telegram Send Message,n8n
  gemini,Google Gemini,external
  serp,SerpAPI,external
  yt,YouTube Data API (product reviews),external
  shops,Amazon + Flipkart price scraping,external
  market,Market Data API (stocks / mutual funds / gold),external
  helplines,Static helpline list,config
  sheets_sms,Sheet tab: sms_messages,sheet
  tx,Sheet tab: transactions,sheet
  habits,Sheet tab: habit_insights,sheet
  snaps,Sheet tab: habit_snapshots,sheet
  briefs,Sheet tab: coach_briefings,sheet
  wish,Sheet tab: shopping_wishlist,sheet
  alerts,Sheet tab: alerts,sheet
  holdings,Sheet tab: investments,sheet

edges[82]{from,to,label}:
  user,tg,sends message
  tg,tg_trigger,bot update
  tg_trigger,onboard,/start from new user
  onboard,tg_send,consent prompt + OAuth link
  onboard,router,sheet linked and ready
  tg_trigger,router,chat_id + text
  router,memory,load and save session
  router,mill,default / logging / dashboard request
  router,chatur,advice / goals / future-buy plan
  router,sera,product search
  router,invest,log holdings / portfolio query
  mill,chatur,escalate: advice request
  mill,sera,escalate: shopping query
  chatur,mill,escalate: expense logging
  sera,chatur,financial decision assessment
  chatur,sera,approved to shop
  mill,tx,read rows for queries
  mill,habits,include Param insights
  mill,serp,get_factual_answer
  mill,dash,create expiring link on request
  user,dash,opens link and explores
  dash,tx,reads classified data
  dash,habits,reads patterns
  dash,wish,reads wishlist
  dash,holdings,reads investments
  android,sms_hook,transaction SMS only (filtered on device)
  sms_hook,sheets_sms,append with processed=false
  sms_cron,dev,every 5-15 min
  dev,sheets_sms,read unprocessed
  dev,valid,Gemini parse + dedupe + PII mask
  valid,drop,no: reject
  valid,complete,yes: amount + time from SMS
  complete,mill,no: ask "was this you?" for vendor / purpose
  mill,dev,user answer merged
  mill,dev,cash / manual entries to clean + classify
  complete,classify,yes
  classify,tx,append classified transaction
  dev,sheets_sms,mark processed
  tx,risk,new transaction
  risk,habits,compare with spending baseline
  risk,unusual,check threshold
  unusual,alerts,yes: log alert
  unusual,helplines,yes: pick helpline
  helplines,tg_send,warning + helpline numbers
  param_cron,param,scheduled run
  param,tx,read unanalyzed / mark analyzed
  param,habits,upsert patterns + user type
  param,snaps,append snapshot
  param,chatur,coach handoff
  chatur,param,trigger if last run over 24h
  chatur,habits,read insights
  chatur,tx,read history
  chatur,holdings,read net worth
  chatur,calc,calculation queries
  chatur,analyzer,vendor-level analysis
  chatur,briefs,cache and store Q&A
  chatur,wish,save future-buy plan + budget
  sera,habits,read user type + income for budget
  sera,serp,search products
  sera,yt,find reviews
  sera,pricewatch,chosen product
  pricewatch,shops,fetch price history
  pricewatch,wish,add item + user target price
  price_cron,pricewatch,scheduled check
  pricewatch,target_hit,compare to target
  target_hit,tg_send,yes: price alert
  invest,holdings,append / read holdings
  invest,market,fetch live prices
  invest,tg_send,net value + profit / loss
  stock_cron,invest,scheduled check
  invest,stock_drop,compare with last price
  stock_drop,tg_send,yes: awareness alert only - no advice
  mill,retry,LLM calls
  chatur,retry,LLM calls
  param,retry,LLM calls
  dev,retry,LLM calls
  sera,retry,LLM calls
  retry,gemini,guarded request
  mill,tg_send,reply
  chatur,tg_send,reply
  sera,tg_send,reply
  tg_send,user,delivered in Telegram chat

flows:
  chat_flow[7]: user,tg,tg_trigger,router,agent,sheets,tg_send
  sms_flow[9]: android,sms_hook,sheets_sms,dev,valid,complete,mill,classify,tx
  insight_flow[5]: param_cron,param,habits,chatur,tg_send
  shopping_flow[6]: sera,yt,pricewatch,wish,target_hit,tg_send
  invest_flow[5]: stock_cron,invest,market,stock_drop,tg_send
  alert_flow[6]: tx,risk,unusual,alerts,helplines,tg_send


