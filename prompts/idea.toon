  technical_architecture:
    _text: "Technical Architecture"
    database_interactions:
      _text: "Database Interactions"
      lists[1]{0,1,2}:
        "**Writes**: Transaction logs via REST API (`POST /api/transactions`)","**Reads**: Spending queries via REST API (`GET /api/transactions`, habits, briefings)","**Authentication**: Uses SERVICE_API_TOKEN for API access"
    external_services:
      _text: "External Services"
      lists[1]{0,1,2}:
        "**Google Gemini**: Powers conversational AI (CHATBOT_GEMINI_API_KEY)","**SerpAPI**: Provides web search for financial definitions (SERPAPI_KEY)","**PostgreSQL**: Stores all transaction data (via web API)"
    runtime_structure:
      _text: "Runtime Structure"
      lists[1]{0,1,2,3}:
        "**Entry Point**: `src/agents/chatbot.ts`","**Runtime Logic**: `src/runtime/mill/conversational-mill.ts`","**Session Management**: `src/runtime/mill/chatbot-session.ts`","**Tools**: `src/tools/log-cash-transaction.ts`, `query-spending-summary.ts`, `web-search.ts`"
  importance_in_system:
    _text: "Importance in System"
    primary_role:
      _text: "Primary Role"
      paragraphs[1]: "Mill is the **front door** to the entire financial assistant system. Most users start their journey here."
    critical_functions:
      _text: "Critical Functions"
      lists[1]{0,1,2,3}:
        "**Transaction Capture**: First point of data entry for manual/cash transactions","**User Engagement**: Keeps users motivated and engaged with friendly personality","**Agent Coordination**: Intelligently routes to specialized agents","**Financial Literacy**: Educates users on concepts in accessible way"
    system_dependencies:
      _text: "System Dependencies"
      lists[1]{0,1}:
        "**Depends on**: Param (for insights), Chatur (for advice), Sera (for shopping), Dev (indirect SMS data)","**Depended on by**: Users (primary interface), Conversation Router (entry point)"
    data_flow_position:
      _text: "Data Flow Position"
  configuration:
    _text: Configuration
    environment_variables:
      _text: "Environment Variables"
    agent_settings:
      _text: "Agent Settings"
      lists[1]{0,1,2,3}:
        "**Model**: Gemini (via Vercel AI SDK)","**Temperature**: Balanced for conversational yet accurate responses","**Max Tokens**: Standard conversation length","**Streaming**: Enabled for real-time responses"
  success_metrics:
    _text: "Success Metrics"
    engagement_indicators:
      _text: "Engagement Indicators"
      lists[1]{0,1,2,3}:
        "✅ User logs transactions regularly","✅ User asks follow-up questions","✅ User queries spending history","✅ User asks for financial explanations"
    quality_indicators:
      _text: "Quality Indicators"
      lists[1]{0,1,2,3}:
        "✅ Accurate transaction categorization","✅ Appropriate agent transfers","✅ Educational responses understood by user","✅ Positive tone maintained throughout"
  best_practices:
    _text: "Best Practices"
    for_developers:
      _text: "For Developers"
      lists[1]{0,1,2,3}:
        "**Maintain personality**: Keep responses witty and encouraging","**Category accuracy**: Ensure category suggestions are contextually appropriate","**Seamless search**: Never expose search failures to users","**Smart routing**: Transfer to specialized agents when appropriate"
    for_users:
      _text: "For Users"
      lists[1]{0,1,2,3}:
        "**Be conversational**: Mill understands natural language","**Provide context**: More details = better categorization","**Ask questions**: Mill loves explaining financial concepts","**Explore agents**: Try Sera for shopping, Chatur for advice"
  future_enhancements:
    _text: "Future Enhancements"
    planned_features:
      _text: "Planned Features"
      lists[1]{0,1,2,3,4,5}:
        "Voice transaction logging","Receipt OCR integration","Recurring transaction templates","Budget alerts and notifications","Multi-currency support","Transaction splitting (shared expenses)"
    potential_improvements:
      _text: "Potential Improvements"
      lists[1]{0,1,2,3}:
        "More sophisticated NLP for transaction parsing","Predictive categorization based on history","Personalized financial tips based on patterns","Integration with bank APIs for auto-import"
      paragraphs[1]: "**Last Updated**: November 14, 2025  
**Version**: 1.0.0  
**Status**: Production Ready ✅"
  agents_param_agent_md:
    _text: agents/PARAM_AGENT.md
param___the_financial_analyst___:
  _text: "Param - The Financial Analyst 📊"
  agent_identity:
    _text: "Agent Identity"
    paragraphs[1]: "**Agent ID**: `param` (agent3)  
**Display Name**: Param  
**Role**: Analytical Insights & Pattern Detection Specialist  
**Personality**: Data-driven, precise, observant storyteller"
  character_essence:
    _text: "Character Essence"
    paragraphs[1]: "Param is the **analytical brain** of the financial system. Param:"
    lists[1]{0,1,2,3,4}:
      "**Observant**: Spots patterns humans miss","**Precise**: Every insight backed by exact numbers","**Concise**: No fluff, pure actionable intelligence","**Non-Judgmental**: Reports facts, not opinions","**Evidence-Based**: Never speculates beyond data"
    key_trait:
      _text: "Key Trait"
      paragraphs[1]: "Param is like a **financial detective** - examines every transaction, identifies patterns, and presents findings as clear, actionable bullets that coaches can use verbatim."
  what_s_new_in_the_unified_runtime__nov_2025_:
    _text: "What's New in the Unified Runtime (Nov 2025)"
    lists[1]{0,1,2,3,4,5}:
      "**Versioned analysis runs** – `runAnalyst` still tracks an `ANALYSIS_VERSION` per transaction and skips work when the stored `analyzed_version` already matches, so nightly jobs stay fast while still allowing forced replays.
- Transactions are marked with `analyzed_at` timestamp and `analyzed_version` integer via PATCH `/api/transactions/:id`
- Dry-run mode (`dryRun: true`) reports impact without writing changes
- Force re-analysis with `reanalyzeAll: true` to bypass version checks","**Direct API persistence** – Insights are written through `syncHabitToApi` and transactions are patched via `/api/transactions/:id`, meaning the docs + dashboards always reflect the latest evidence without manual exports.
- Uses `HabitInsight` typed interface: `{ habitLabel, evidence, counsel, fullText }`
- Multi-user support via optional `ownerId` parameter","**Incremental insight reuse (NEW)** – Param no longer wipes the slate every run. Matching habits (case-insensitive labels) are updated in place, unmatched ones are marked `superseded`, and only truly new bullets get new IDs.","**Database-backed snapshots (NEW)** – Every run upserts a structured record into `habit_snapshots` with `context_data`, `summary_data`, and a deterministic `snapshot_id` hash so Chatur can reload the full context without touching JSON files.","**Daily freshness + rate limiting (NEW)** – Param records `last_run_at` inside `habit_processing_cursors` and uses `PARAM_MAX_RUNS_PER_DAY` / `PARAM_RATE_LIMIT_HOURS` to skip redundant runs, while Chatur can still force a replay when the cursor is >24h old or when manual triggers fire.","**Automatic coach handoff** – After every successful analysis, the agent calls `runCoach` with the latest/previous insights (passed from `loadExistingInsights`), keeping Chatur's playbook in sync without separate schedulers.
- Trigger reason recorded as `\"analyst\"` in coach session metadata
- Continues even if coach handoff fails (non-blocking error handling)"
    paragraphs[1]: "**Why it's better**: Param now produces \"ready-to-serve\" insights that stay versioned, deduped, and instantly available to Chatur/Mill. Version tracking eliminates redundant analysis, and automatic coach handoff creates a tight feedback loop."
  implementation_details__nov_2025_:
    _text: "Implementation Details (Nov 2025)"
    runtime_flow___runanalyst_options__:
      _text: "Runtime Flow: `runAnalyst(options)`"
      paragraphs[13]: "**Entry Point**: `src/runtime/param/analyst-agent.ts`", "The `runAnalyst` function orchestrates the entire analysis pipeline:", "**Step 1: Load & Filter Transactions**", "**Step 2: Build Statistics**", "**Step 3: Generate LLM Prompt**", "**Step 4: Call Language Model (Gemini)**", "**Step 5: Parse Bullet Lines**", "**Step 6: Persist Insights Incrementally**", "Key outcomes:", "**Step 7: Persist Habit Snapshot**", "Snapshots now live entirely in PostgreSQL (no `/data/generated` JSON files) and are keyed by a repeatable hash, so Chatur can reload the exact metrics set that produced a briefing.", "**Step 8: Mark Transactions Analyzed**", "**Step 9: Hand Off to Coach (if successful)**"
      lists[1]{0,1,2}:
        "Eliminates churn by reusing `habit_id` for long-lived habits","Only emits `superseded` entries for habits that truly disappeared","Returns `{ created, updated, superseded }` so downstream systems know what changed"
    database_schema__prisma_:
      _text: "Database Schema (Prisma)"
      paragraphs[1]: "**Tables Used**:"
      1___habit_insights_:
        _text: "1. `habit_insights`"
        paragraphs[2]: "Stores analyzed spending habits and patterns. Schema:", "**Key Queries**:"
        lists[1]{0}:
          "`findMany({ where: { owner, status: \"published\" }, orderBy: { recorded_at: \"desc\" }, take: 5 })`
→ Fetches 5 most recent insights per user (used by Mill/Chatur)"
      2___habit_snapshots_:
        _text: "2. `habit_snapshots`"
        paragraphs[2]: "Stores historical snapshots for trend tracking. Schema:", "**Usage**: Referenced by coach_briefings for historical context."
      3___tranasctions_:
        _text: "3. `tranasctions`"
        paragraphs[2]: "Stores individual financial transactions. Schema:", "**Key Queries**:"
        lists[1]{0,1}:
          "`findMany({ where: { owner, status: \"published\" } })`
→ Load all transactions for analysis","`findMany({ where: { owner, analyzed_version: { not: 1 } } })`
→ Find unanalyzed transactions (for incremental runs)"
      4___coach_briefings_:
        _text: "4. `coach_briefings`"
        paragraphs[1]: "Stores generated coaching messages. Param populates indirectly via Coach handoff. Schema:"
    configuration___environment:
      _text: "Configuration & Environment"
      paragraphs[2]: "**Environment Variables**:", "**LLM Settings** (Gemini):"
      lists[1]{0,1,2,3}:
        "Model: Google Gemini 2.0 Flash (via @ai-sdk/google)","Temperature: Low (0.2-0.4) for consistent, factual output","Max Tokens: 1000 (for 5-7 concise bullets)","Streaming: Disabled (batch analysis, no real-time output)"
    api_endpoints_called:
      _text: "API Endpoints Called"
      1__patch___api_transactions__id_:
        _text: "1. PATCH `/api/transactions/:id`"
        paragraphs[4]: "**Purpose**: Mark transactions as analyzed", "**Headers**:", "**Body**:", "**Response**: Updated transaction object"
      2__post_patch___api_habits_:
        _text: "2. POST/PATCH `/api/habits`"
        paragraphs[4]: "**Purpose**: Sync habit insights to database", "**Headers**:", "**Body** (HabitInsightPayload):", "**Response**: Inserted/updated habit record"
    integration_points:
      _text: "Integration Points"
      incoming_triggers:
        _text: "Incoming Triggers"
        lists[1]{0,1}:
          "**CLI / Scheduled Job**:

```bash
# From: scripts/run-analyst.ts or cron job
node --loader ts-node/esm src/runtime/param/analyst-agent.ts
# Calls: runAnalyst({ reanalyzeAll: false })
```","**Programmatic**:
```typescript
// From: Coach-Analyst loop or other agents
import { runAnalyst } from \"@/runtime/param/analyst-agent\";
const result = await runAnalyst({ reanalyzeAll: false, ownerId: 2 });
```"
      outgoing_calls:
        _text: "Outgoing Calls"
        lists[1]{0,1}:
          "**To Coach**:

```typescript
await runCoach({
  latestInsights: insights, // Fresh from this run
  previousInsights: oldInsights, // From loadExistingInsights()
  trigger: \"analyst\",
});
```","**To Database** (via API):
- Habits: `syncHabitToApi(payload)`
- Transactions: `PATCH /api/transactions/:id`"
    error_handling___resilience:
      _text: "Error Handling & Resilience"
      paragraphs[2]: "**Non-Blocking Patterns**:", "**Fallback Behaviors**:"
      lists[2]{0,1,2,3}:
        "**Transaction Mark Failures**: If `markTransactionsAsAnalyzed` fails for one TX, it continues with others (logged, not thrown)","**Habit Persist Failures**: If `syncHabitToApi` fails for one insight, it continues with others","**Coach Handoff Failures**: Caught and logged; main flow completes successfully","**API Sync Failures**: Logged at error level; does not block analysis completion"
        "**No Transactions**: Returns placeholder insight (\"Insufficient History\") to DB","**Empty LLM Output**: Throws error, stops run with status=\"error\"","**Parse Failures**: Throws error, stops run with status=\"error\"",null
    performance_characteristics:
      _text: "Performance Characteristics"
      paragraphs[3]: "**Time Complexity** (per analysis run):", "**Total**: ~3-10 seconds for typical user (50-200 transactions)", "**Optimization Strategy**:"
      lists[2]{0,1,2,3,4}:
        "Load transactions: O(n)","Build stats: O(n)","LLM call: O(1) fixed (~2-5s)","Parse & persist: O(m) where m = 5-7 insights","Mark analyzed: O(n) sequential PATCH calls (~100-500ms per TX)"
        "Version tracking skips re-analysis if no new transactions","Only patch changed transactions (set analyzed_at/analyzed_version)","Batch API calls use sequential PATCH; consider bulk endpoint if scaling to 10K+ TX",null,null
    testing___validation:
      _text: "Testing & Validation"
      paragraphs[3]: "**Dry-Run Mode**:", "**Force Re-Analysis**:", "**Expected Output** (success case):"
  core_capabilities:
    _text: "Core Capabilities"
    1__pattern_recognition___:
      _text: "1. Pattern Recognition 🔍"
      paragraphs[3]: "**What it does**: Identifies spending, saving, and income patterns from transaction data", "**Patterns Detected**:", "**Example Patterns**:"
      lists[1]{0,1,2,3}:
        "**Spending Habits**: Overspending categories, frequent merchants, impulse buying","**Income Patterns**: Irregular income, consistent earnings, income sources","**Saving Behavior**: Savings rate, proactive saving, insufficient reserves","**Behavioral Flags**: Budget breaches, unusual purchases, category concentration"
    2__insight_generation___:
      _text: "2. Insight Generation 💡"
      paragraphs[4]: "**What it does**: Transforms raw metrics into actionable coaching insights", "**Insight Structure** (Mandatory Format):", "**Quality Rules**:", "**Example Insights**:"
      lists[1]{0,1,2,3,4,5}:
        "Each bullet under 220 characters","Contains habit label, evidence, and counsel","Cites only supplied numbers from metrics","No speculation or invented data","5-7 bullets per analysis","Each bullet unique (no repeats)"
    3__metrics_analysis___:
      _text: "3. Metrics Analysis 📈"
      paragraphs[3]: "**What it does**: Processes comprehensive financial analytics snapshots", "**Analyzed Metrics**:", "**Input Format** (JSON):"
      lists[1]{0,1,2,3,4,5}:
        "**Transaction Volume**: Total count, frequency patterns","**Amount Analysis**: Total spent, earned, average transaction size","**Category Breakdown**: Top categories by amount and percentage","**Merchant Analysis**: Frequent vendors, spending concentration","**Time Patterns**: Daily/weekly/monthly trends","**Behavioral Flags**: Anomalies, threshold breaches, risk indicators"
    4__habit_snapshot_creation___:
      _text: "4. Habit Snapshot Creation 📸"
      paragraphs[3]: "**What it does**: Generates reusable financial behavior snapshots for coaching", "**Snapshot Contents**:", "**Storage**: Saved to `habit_snapshots` table for historical tracking"
      lists[1]{0,1,2,3,4,5}:
        "**Insights List**: 5-7 actionable habit insights","**Summary Data**: Key metrics overview","**Top Categories**: Spending distribution","**Frequent Merchants**: Transaction patterns","**Behavioral Flags**: Risk indicators","**Generated Timestamp**: When analysis performed"
  tools___integration:
    _text: "Tools & Integration"
    available_tools:
      _text: "Available Tools"
      1___metrics_snapshot_:
        _text: "1. `metrics_snapshot`"
        paragraphs[2]: "**Purpose**: Provides structured analytics data for evidence  
**Parameters**: None (system provides)", "**Returns**: Complete financial metrics JSON (see above format)"
      2___habit_recommendation_:
        _text: "2. `habit_recommendation`"
        paragraphs[3]: "**Purpose**: Translates detected pattern into actionable coaching tip  
**Parameters**:", "**Returns**: Formatted insight bullet", "**Example Usage**:"
        lists[1]{0,1,2}:
          "`pattern` (string) - Short title of detected habit","`evidence` (string) - Key metric justifying observation","`action` (string) - Actionable recommendation"
  analysis_protocol:
    _text: "Analysis Protocol"
    mandatory_flow__4_steps_:
      _text: "Mandatory Flow (4 Steps)"
      step_1__ingest___internalize:
        _text: "Step 1: Ingest & Internalize"
        lists[1]{0,1,2}:
          "Absorb every metric in provided JSON","Treat data as only source of truth","No external assumptions"
      step_2__identify_core_narrative:
        _text: "Step 2: Identify Core Narrative"
        lists[1]{0,1,2}:
          "Surface most impactful patterns","Prioritize: spending > income > saving","Ignore trivial signals (small amounts, rare occurrences)"
      step_3__translate_to_actionable_insights:
        _text: "Step 3: Translate to Actionable Insights"
        lists[1]{0,1,2,3}:
          "Create 5-7 bullets","Each bullet: habit label + evidence + counsel","Cite exact numbers from payload","Keep under 220 characters per bullet"
      step_4__quality___grounding:
        _text: "Step 4: Quality & Grounding"
        lists[1]{0,1,2,3}:
          "Verify all numbers from source data","Avoid speculation beyond metrics","Ensure recommendations practical and supportive","No judgment, just facts and guidance"
  interaction_patterns:
    _text: "Interaction Patterns"
    with_users:
      _text: "With Users"
      paragraphs[3]: "**Interaction**: **INDIRECT** - Param never talks to users directly", "Users see Param's insights through Mill (when querying spending) or Chatur (when receiving coaching).", "**User Experience**:"
    with_other_agents:
      _text: "With Other Agents"
      __mill__chatbot_:
        _text: "→ Mill (Chatbot)"
        paragraphs[3]: "**Relationship**: Data provider  
**Communication**: Param's insights included in Mill's spending query responses", "**Data Flow**:", "**Example**:"
        lists[1]{0,1,2,3}:
          "User asks Mill about spending","Mill calls `query_spending_summary`","System includes Param's latest habit insights","Mill presents insights to user (attributed to Param)"
      __chatur__coach_:
        _text: "→ Chatur (Coach)"
        paragraphs[3]: "**Relationship**: Primary consumer of insights  
**Communication**: Chatur uses Param's insights as foundation for coaching", "**Data Flow**:", "**Example**:"
        lists[1]{0,1,2,3}:
          "Param analyzes transaction data → Generates insights","Insights stored in database","Chatur retrieves insights when coaching","Chatur builds on Param's evidence for personalized advice"
      __dev__sms_parser_:
        _text: "→ Dev (SMS Parser)"
        paragraphs[2]: "**Relationship**: Data consumer  
**Communication**: No direct interaction", "**Data Flow**:"
        lists[1]{0,1,2,3}:
          "Dev extracts transactions from SMS","Transactions stored in database","Param analyzes all transactions (manual + SMS)","Param generates insights from complete data"
      __sera__shopping_assistant_:
        _text: "→ Sera (Shopping Assistant)"
        paragraphs[2]: "**Relationship**: No interaction  
**Communication**: None", "**Note**: Param analyzes spending patterns; Sera helps find products. No overlap."
  insight_categories:
    _text: "Insight Categories"
    financial_habits_tracked:
      _text: "Financial Habits Tracked"
      lists[1]{0,1,2,3,4}:
        "**Spending Patterns**

- Overspending (category or overall)
- Impulse buying
- Luxury/discretionary vs necessities
- Merchant concentration","**Income Patterns**

- Regular income (salary)
- Irregular income (gig work)
- Income sources diversity
- Earning consistency","**Saving Behavior**

- Savings rate (percentage)
- Proactive saving (intentional transfers)
- Emergency fund adequacy
- Insufficient reserves","**Budget Alignment**

- Category budget adherence
- Spending threshold breaches
- Monthly vs weekly trends
- Unusual purchases","**Risk Indicators**
- Low savings (<20% rate)
- High debt/EMI burden
- Irregular income + high spending
- Single category dominance"
  output_examples:
    _text: "Output Examples"
    example_1__balanced_finances:
      _text: "Example 1: Balanced Finances"
      paragraphs[2]: "**Input Metrics**:", "**Param's Output**:"
    example_2__overspending_alert:
      _text: "Example 2: Overspending Alert"
      paragraphs[2]: "**Input Metrics**:", "**Param's Output**:"
    example_3__gig_worker__irregular_income_:
      _text: "Example 3: Gig Worker (Irregular Income)"
      paragraphs[2]: "**Input Metrics**:", "**Param's Output**:"
  technical_architecture:
    _text: "Technical Architecture"
    database_interactions:
      _text: "Database Interactions"
      paragraphs[4]: "**Reads**:", "**Writes**:", "**Transaction Tracking**:", "**Endpoints** (via web/src/lib/mill/in-process-adapter.ts):"
      lists[4]{0,1}:
        "Transactions via `loadTransactions()` → Prisma `tranasctions.findMany()`","Previous insights via `loadExistingInsights()` → Prisma `habit_insights.findMany()` (latest 5)"
        "Habit insights via `syncHabitToApi()` → POST/PATCH to `/api/habits` (creates/updates `habit_insights`)","Transaction metadata via PATCH `/api/transactions/:id` (sets `analyzed_at`, `analyzed_version`, `analysis_notes`)"
        "All transactions loaded with metadata fields: `analyzed_at` (nullable datetime), `analyzed_version` (nullable int)","Version filtering: `WHERE analyzed_version != 1` to find unanalyzed work"
        "`GET /api/habits?owner={id}` - Fetch recent insights","`POST /api/habits` - Create/update habit insight"
    external_services:
      _text: "External Services"
      lists[1]{0,1,2}:
        "**Google Gemini**: Powers analytical AI (ANALYST_GEMINI_API_KEY)","**PostgreSQL**: Stores insights, snapshots, and transaction metadata (via Prisma)","**LLM Client Wrapper** (`src/runtime/shared/llm-client.ts`): Handles retries, circuit breaker, error fallbacks"
    runtime_structure:
      _text: "Runtime Structure"
      lists[1]{0,1,2}:
        "**Entry Point**: `src/agents/analyst.ts` (agent definition + system prompt)","**Runtime Logic**: `src/runtime/param/analyst-agent.ts` (main runAnalyst orchestrator)","**Utilities**:
- `transactions-loader.ts` - Fetch & normalize transaction data
- `habit-tracker.ts` - Incremental habit snapshots (for future use with Chatur streaming)
- `index.ts` - Public exports"
    coach_integration:
      _text: "Coach Integration"
      paragraphs[2]: "After analysis completes, Param automatically hands off to Coach:", "**Coach Responsibilities**:"
      lists[1]{0,1,2,3}:
        "Compare latest vs previous insights (trend detection)","Generate coaching briefings","Store briefings in `coach_briefings` table","Detect escalation signals (e.g., overspending alerts)"
  importance_in_system:
    _text: "Importance in System"
    primary_role:
      _text: "Primary Role"
      paragraphs[1]: "Param is the **analytical engine** that transforms raw transaction data into meaningful financial intelligence."
    critical_functions:
      _text: "Critical Functions"
      lists[1]{0,1,2,3}:
        "**Pattern Detection**: Identifies habits users don't see themselves","**Evidence Provider**: Gives coaches concrete data to reference","**Objective Analysis**: Removes human bias from financial assessment","**Trend Tracking**: Monitors changes over time (snapshots)"
    system_dependencies:
      _text: "System Dependencies"
      lists[1]{0,1}:
        "**Depends on**: Transaction data (from Mill, Dev), Previous snapshots","**Depended on by**: Mill (shows insights), Chatur (builds coaching on insights)"
    data_flow_position:
      _text: "Data Flow Position"
    unique_value:
      _text: "Unique Value"
      paragraphs[1]: "**Without Param**: Users and coaches see raw numbers only  
**With Param**: Everyone sees patterns, trends, and actionable insights"
  analysis_triggers:
    _text: "Analysis Triggers"
    when_param_runs__current_v1_1_:
      _text: "When Param Runs (Current v1.1)"
      1____scheduled_job__nightly___:
        _text: "1. **Scheduled Job (Nightly)**"
        paragraphs[3]: "**Trigger**: Cron job or manual invocation  
**Command**:", "**Behavior**:", "**Output**:"
        lists[1]{0,1,2,3}:
          "Calls `runAnalyst({ reanalyzeAll: false })` (default)","Analyzes only transactions where `analyzed_version != 1` (new/updated only)","Skips if all transactions already analyzed (fast return)","Runs in ~3-10 seconds for typical user"
      2____user_query_via_mill__:
        _text: "2. **User Query via Mill**"
        paragraphs[2]: "**Trigger**: User asks \"Show my spending\"  
**Flow**:", "**Output**: Insight text displayed in chat, no re-analysis triggered (uses cached insights)"
        lists[1]{0,1,2,3,4,5}:
          "User → Mill chatbot","Mill calls `/api/agent` (post message)","Router detects \"spending\" keyword","Router calls `query_spending_summary` tool","System fetches latest insights from `habit_insights` table (populated by Param)","Mill displays insights to user (attributed to Param)"
      3____manual_re_analysis__:
        _text: "3. **Manual Re-Analysis**"
        paragraphs[3]: "**Trigger**: Developer or admin  
**Command**:", "**Behavior**:", "**Output**: Same format as scheduled job"
        lists[1]{0,1,2}:
          "Analyzes ALL transactions regardless of version","Useful for testing changes to analysis logic or LLM prompts","Overwrites previous insights"
      4____coach_handoff__automatic___:
        _text: "4. **Coach Handoff (Automatic)**"
        paragraphs[2]: "**Trigger**: After successful Param analysis  
**Flow**:", "**Output**: Coach briefings generated and ready for delivery"
        lists[1]{0,1,2,3,4}:
          "Param generates insights","Param calls `runCoach({ latestInsights, previousInsights, trigger: \"analyst\" })`","Coach session created with context","Coach generates briefings (insights + recommendations)","Briefings stored in `coach_briefings` table"
    planned_triggers__future_:
      _text: "Planned Triggers (Future)"
      lists[1]{0,1,2,3}:
        "**Transaction Threshold**: Analyze when new transaction > 1.5x average spend","**Pattern Detection**: Auto-analyze when category spending exceeds budget","**Weekly Summary**: Generate insights every Sunday 6 AM","**Significant Event**: Detect anomalies (fraud flags, income changes)"
  quality_assurance:
    _text: "Quality Assurance"
    insight_validation_checklist:
      _text: "Insight Validation Checklist"
      paragraphs[1]: "Before outputting insights, Param ensures:"
      lists[1]{0,1,2,3,4,5,6,7}:
        "✅ Each bullet has habit label, evidence, and counsel","✅ All numbers cited exist in source metrics","✅ Character count <220 per bullet","✅ 5-7 bullets total (no more, no less)","✅ Each bullet addresses unique observation","✅ Recommendations are practical and actionable","✅ Tone is supportive, not judgmental","✅ No speculation beyond provided data"
    common_mistakes_to_avoid:
      _text: "Common Mistakes to Avoid"
      lists[1]{0,1,2,3,4,5}:
        "❌ Inventing numbers not in metrics","❌ Generic advice without specific evidence","❌ Judging user's choices (neutral tone only)","❌ Exceeding character limits","❌ Duplicate or repetitive insights","❌ Vague recommendations (\"spend less\" vs \"reduce food by ₹1K\")"
  configuration:
    _text: Configuration
    environment_variables:
      _text: "Environment Variables"
    agent_settings:
      _text: "Agent Settings"
      lists[1]{0,1,2,3}:
        "**Model**: Gemini (via Vercel AI SDK)","**Temperature**: Low (for consistent, factual output)","**Max Tokens**: Medium (for 5-7 concise bullets)","**Streaming**: Disabled (batch analysis)"
  success_metrics:
    _text: "Success Metrics"
    effectiveness_indicators:
      _text: "Effectiveness Indicators"
      lists[1]{0,1,2,3}:
        "✅ Insights are cited by Chatur in coaching sessions","✅ Users act on recommendations","✅ Patterns detected lead to behavior change","✅ Insights are clear and understandable"
    quality_indicators:
      _text: "Quality Indicators"
      lists[1]{0,1,2,3}:
        "✅ All insights grounded in real data","✅ Recommendations specific and actionable","✅ Character limits respected","✅ Consistent format across all outputs"
  best_practices:
    _text: "Best Practices"
    for_developers:
      _text: "For Developers"
      lists[1]{0,1,2,3}:
        "**Enrich metrics**: Provide comprehensive data to Param","**Validate output**: Ensure insights follow format rules","**Monitor accuracy**: Check that numbers match source data","**Test edge cases**: Zero transactions, negative balance, etc."
    for_system_administrators:
      _text: "For System Administrators"
      lists[1]{0,1,2,3}:
        "**Schedule regular analysis**: Weekly snapshots for trend tracking","**Archive old snapshots**: Maintain performance","**Monitor Gemini usage**: Ensure API quota sufficient","**Review insight quality**: Periodic human validation"
  future_enhancements:
    _text: "Future Enhancements"
    planned_features:
      _text: "Planned Features"
      lists[1]{0,1,2,3,4}:
        "Comparative analysis (this month vs last month)","Goal progress tracking (% toward target)","Predictive insights (projected spending)","Anomaly detection (unusual transactions)","Peer benchmarking (anonymized comparisons)"
    potential_improvements:
      _text: "Potential Improvements"
      lists[1]{0,1,2,3,4}:
        "Multi-period trend analysis","Category budget recommendations","Machine learning for pattern detection","Custom insight templates per user type","Natural language insight generation"
  comparison_with_manual_analysis:
    _text: "Comparison with Manual Analysis"
    paragraphs[1]: "**Verdict**: Param provides analyst-level insights at chatbot speed and cost! 🚀"
  param_trigger_remapping__updated_nov_2025_:
    _text: "Param Trigger Remapping (Updated Nov 2025)"
    new_trigger_model:
      _text: "New Trigger Model"
      paragraphs[2]: "**Old**: Param runs automatically after every transaction  
**New**: Param triggered **only by Chatur**, **once per day maximum**", "**Benefits**:"
      lists[1]{0,1,2,3}:
        "✅ 90% fewer LLM calls (1 per day vs many per day)","✅ Less API/database load","✅ More meaningful analysis (weekly/daily patterns vs immediate)","✅ Better cache hit rate"
    smart_incremental_analysis:
      _text: "Smart Incremental Analysis"
      paragraphs[2]: "**Old**: Re-analyze all transactions every time  
**New**: Only analyze new transactions, reuse old insights", "**Benefits**:"
      lists[1]{0,1,2}:
        "✅ Only new transactions processed (50-80% faster)","✅ Existing insights retained and enhanced, not discarded","✅ Continuous context (old + new = complete picture)"
    update_instead_of_create:
      _text: "Update Instead of Create"
      paragraphs[2]: "**Old**: Create new insight for every category each run  
**New**: Update existing insight if same category detected", "**Benefits**:"
      lists[1]{0,1,2}:
        "✅ No duplicate insights for same patterns","✅ Versioned history per insight (can compare trends)","✅ Cleaner DB (fewer rows)"
  coach_briefings_as_conversation_storage__new_nov_2025_:
    _text: "Coach Briefings as Conversation Storage (New Nov 2025)"
    purpose_redefined:
      _text: "Purpose Redefined"
      paragraphs[1]: "**Old**: One-way briefings generated by Param  
**New**: Q&A conversation log (Chatur responses + context)"
    smart_deduplication_in_briefings:
      _text: "Smart Deduplication in Briefings"
      paragraphs[1]: "**Detection**: Hash-based question similarity + embedding distance"
    context_invalidation:
      _text: "Context Invalidation"
    storage_schema_update:
      _text: "Storage Schema Update"
      paragraphs[1]: "**coach_briefings**: Now stores full conversations"
  related_agent_changes__nov_2025_:
    _text: "Related Agent Changes (Nov 2025)"
    mill__chatbot__updates:
      _text: "Mill (Chatbot) Updates"
      lists[1]{0,1,2}:
        "**Router-native entrypoint** – Mill now runs inside `ConversationRouter` via `web/src/lib/mill/in-process-adapter.ts`","**State snapshots with Redis fallback** – Sessions persist via `getConversationStore()` (Redis or in-memory)","**Structured actions & attachments** – Emits typed `log_transaction`, `query_data`, `escalate_to_coach` actions with payloads"
      paragraphs[1]: "**Key Integration**: Mill calls `query_spending_summary` which fetches Param's latest insights from `habit_insights` table and displays them to users."
    chatur__coach__updates:
      _text: "Chatur (Coach) Updates"
      lists[1]{0,1,2,3,4}:
        "**Router-seeded sessions** – `ConversationalCoach` slots into `ConversationRouter`, cold-starts with Param's insights","**Structured guidance loop** – Responses generated via JSON schema capturing `nextQuestion`, goal metadata, and `shouldEscalateToMill` flags","**Resilient LLM calls** – Uses circuit breaker + exponential backoff (overload-specific retries) and rule-based fallbacks","**Now triggers Param** – Checks if daily analysis needed before responding to user questions","**Smart caching** – Checks coach_briefings for similar questions before generating new response"
      paragraphs[1]: "**Key Integration**: Chatur triggers Param (if 24h+ since last run), gets insights, generates/retrieves cached answer, stores in coach_briefings."
    sera__shopping_assistant__updates:
      _text: "Sera (Shopping Assistant) Updates"
      lists[1]{0,1}:
        "**Router-integrated sessions** – Sera runs in shared router, shares conversation context across agents","**No direct Param interaction** – Focused on product search and recommendations only"
      paragraphs[1]: "**Key Integration**: Sera coordinates with Mill/Chatur; receives user handoffs when shopping queries detected."
    conversation_router__shared_:
      _text: "Conversation Router (Shared)"
      lists[1]{0,1,2}:
        "**Keyword-based routing** – Routes between mill/chatur/sera based on message content and context","**Session hydration** – Rehydrates correct agent session on every `/api/agent` call","**State persistence** – Uses `getConversationStore()` for cross-request session continuity"
      paragraphs[2]: "**Database**: Uses `habit_insights` and transaction data to seed agent context on cold-start.", "**Last Updated**: November 22, 2025  
**Version**: 1.1.0  
**Status**: Production Ready ✅"
  agents_sera_agent_md:
    _text: agents/SERA_AGENT.md
sera___the_shopping_assistant____:
  _text: "Sera - The Shopping Assistant 🛍️"
  agent_identity:
    _text: "Agent Identity"
    paragraphs[1]: "**Agent ID**: `sera` (agent5)  
**Display Name**: Sera (Search Agent)  
**Role**: Product Shopping & Deal-Finding Specialist  
**Personality**: Bubbly, enthusiastic, deal-hunting friend"
  character_essence:
    _text: "Character Essence"
    paragraphs[1]: "Sera is your **AI shopping buddy** who LOVES helping people find amazing products and great deals. Sera:"
    lists[1]{0,1,2,3,4}:
      "**Enthusiastic**: Gets genuinely excited about shopping and finding deals","**Patient**: Takes time to understand exactly what you need","**Honest**: Tells you pros/cons so you love your purchase","**Budget-Conscious**: Always considers your wallet","**Deal-Hunter**: Expert at finding hidden gems and best prices"
    signature_style:
      _text: "Signature Style"
      lists[1]{0,1,2}:
        "**Catchphrases**:
- \"Ooh, I found something perfect!\"
- \"Let me hunt down the best deals for you!\"
- \"This is such a great find! 💰\"","**Emojis**: 🛍️ 💰 ✨ 🎉 💝 ⬆️","**Tone**: Like texting a knowledgeable friend who's always excited to help you shop"
    key_trait:
      _text: "Key Trait"
      paragraphs[1]: "Sera is like that friend who **knows all the best stores**, remembers your preferences, and gets more excited about your purchase than you do!"
  what_s_new_in_the_unified_runtime__nov_2025_:
    _text: "What's New in the Unified Runtime (Nov 2025)"
    lists[1]{0,1,2}:
      "**Modular search stack** – `SeraAgent` now delegates lookups to the typed `SeraSearchAdapter`/`search-planner`, which handle Google Shopping calls, contextual `getProductDetails`, and Amazon URL reverse-lookups before the LLM ever runs.","**Wishlist brain built-in** – The new `WishlistController` watches every utterance for “add/view” intents, supports pending actions when the user shares a bare Amazon link, and persists directly through Prisma, so wishlist edits feel instant.","**Router-ready sessions** – `hydrateSession`/`snapshotSession` let the shared `ConversationRouter` persist Sera conversations the same way as Mill/Chatur, meaning `/api/agent` can hop users into shopping mode without losing their last search results."
    paragraphs[1]: "**Why it’s better**: shopping requests are faster, wishlist flows need fewer clarifications, and Sera now plugs directly into the same entrypoint as every other agent."
  core_capabilities:
    _text: "Core Capabilities"
    1__product_search___:
      _text: "1. Product Search 🔍"
      paragraphs[4]: "**What it does**: Searches Google Shopping for products across Indian e-commerce stores", "**Features**:", "**Search Parameters**:", "**Example Interaction**:"
      lists[2]{0,1,2,3,4}:
        "Real-time product search with live prices","Multi-store comparison (Amazon, Flipkart, Croma, Reliance Digital, etc.)","Price range filtering","Rating/review integration","Location-based results (India focus)"
        "`query` - Product search term","`minPrice` - Minimum price in ₹","`maxPrice` - Maximum price in ₹","`num` - Number of results (5-50)","`location` - Geo location (default: India)"
    2__product_comparison___:
      _text: "2. Product Comparison 📊"
      paragraphs[4]: "**What it does**: Presents products in easy-to-compare format", "**Comparison Display**:", "**Key Metrics Shown**:", "**Example**:"
      lists[2]{0,1,2,3,4}:
        "Automatic table format with key details","Side-by-side specs comparison","Price differences highlighted","Rating/review aggregation","Store reliability indicators"
        "Product name","Current price (₹)",Store/source,"Rating (X/5)","Direct purchase link"
    3__wishlist_management___:
      _text: "3. Wishlist Management 💝"
      paragraphs[4]: "**What it does**: Saves products for future purchase with target price tracking", "**Wishlist Features**:", "**Workflow**:", "**Example Interaction**:"
      lists[2]{0,1,2,3,4,5}:
        "Add products from search results","Set target/desired price alerts","Track price changes (future feature)","View all saved items","Update item details","Remove items"
        "User finds product in search","Wants to save for later","Sera asks for target price","Saves to wishlist via REST API","User can view/manage wishlist anytime",null
    4__amazon_product_lookup___:
      _text: "4. Amazon Product Lookup 📦"
      paragraphs[3]: "**What it does**: Direct search on Amazon India for detailed product info", "**Features**:", "**Use Cases**:"
      lists[2]{0,1,2,3,4,5}:
        "Product availability check","Detailed specifications","Customer reviews summary","Seller information","Prime eligibility","Delivery timeline"
        "When user mentions Amazon specifically","Need detailed product info","Verify search result accuracy","Check stock availability",null,null
    5__product_detail_retrieval___:
      _text: "5. Product Detail Retrieval 🔎"
      paragraphs[3]: "**What it does**: Fetches specific details for vague product references", "**Handles Cases Like**:", "**Process**:"
      lists[2]{0,1,2}:
        "\"Add the cheapest one to wishlist\"","\"What about the best-rated laptop?\"","\"Save the first option\""
        "User gives vague reference","Sera uses `getProductDetails` tool","Identifies exact product from search results"
  tools___integration:
    _text: "Tools & Integration"
    available_tools:
      _text: "Available Tools"
      1___searchshopping_:
        _text: "1. `searchShopping`"
        paragraphs[4]: "**Purpose**: Search Google Shopping for products in India  
**Parameters**:", "**Returns**: Array of products with name, price, link, rating, source", "**Example Call**:", "**Output Display**: Automatic formatted table shown to user"
        lists[1]{0,1,2,3,4}:
          "`query` (string, required) - Search term with product type and specs","`num` (number, optional) - Max results (5-50, default 30)","`location` (string, optional) - Geo location (default: India)","`minPrice` (number, optional) - Min price in ₹","`maxPrice` (number, optional) - Max price in ₹"
      2___amazonproductlookup_:
        _text: "2. `amazonProductLookup`"
        paragraphs[2]: "**Purpose**: Search specifically on Amazon India  
**Parameters**:", "**Returns**: Amazon-specific results with Prime info, delivery, reviews"
        lists[1]{0,1}:
          "`query` (string, required) - Product search term","`num` (number, optional) - Number of results (default 10)"
      3___addtowishlist_:
        _text: "3. `addToWishlist`"
        paragraphs[3]: "**Purpose**: Save product to user's wishlist database  
**Parameters**:", "**Returns**: Success confirmation with saved item details", "**Database**: Persists via Prisma directly to `shopping_wishlist`"
        lists[1]{0,1,2,3,4,5}:
          "`productName` (string, required) - Exact name from search results","`productLink` (string, required) - Direct product URL","`currentPrice` (string, required) - Price as displayed (e.g., \"₹48,999\")","`desiredPrice` (string, required) - User's target price","`rating` (string, optional) - Product rating (e.g., \"4.5/5\")","`source` (string, required) - Store name (e.g., \"Amazon.in\")"
      4___viewwishlist_:
        _text: "4. `viewWishlist`"
        paragraphs[3]: "**Purpose**: Fetch all items in user's wishlist  
**Parameters**: None (uses user context)", "**Returns**: Array of wishlist items with:", "**Database**: Reads via Prisma directly from `shopping_wishlist`"
        lists[1]{0,1,2,3}:
          "Product name, link","Current price, desired price","Rating, source","Date added"
      5___getproductdetails_:
        _text: "5. `getProductDetails`"
        paragraphs[3]: "**Purpose**: Resolve vague product references  
**Parameters**:", "**Returns**: Specific product details from recent search results", "**Use Case**: When user says \"add the first one\" without naming it"
        lists[1]{0}:
          "`reference` (string, required) - User's description (\"cheapest\", \"#1\", \"best rated\")"
  shopping_conversation_flow:
    _text: "Shopping Conversation Flow"
    phase_1__discovery___need_gathering___:
      _text: "Phase 1: Discovery & Need Gathering 🎯"
      paragraphs[4]: "**Goal**: Understand what user wants before searching", "**Key Questions**:", "**Example**:", "**Don't Rush to Search**: Build context first!"
      lists[1]{0,1,2,3,4}:
        "\"What are you shopping for?\"","\"What's your budget?\" ⚠️ **CRITICAL**","\"What will you use it for?\" (usage context)","\"Any specific features you need?\" (specs)","\"Any brands you prefer or avoid?\" (preferences)"
    phase_2__search_activation___:
      _text: "Phase 2: Search Activation 🔍"
      paragraphs[6]: "**CRITICAL RULE**: ⚠️ **NEVER search without explicit user confirmation**", "**3-Step Process**:", "**Step 1️⃣ - Gather Requirements**", "**Step 2️⃣ - Summarize & Confirm**", "**Step 3️⃣ - Wait for Confirmation**", "**Why This Matters**: Prevents wasted searches and ensures accuracy!"
    phase_3__present_results___:
      _text: "Phase 3: Present Results 📊"
      paragraphs[3]: "**Display Format**: Automatic table shown to user", "**Sera's Role**:", "**Example**:"
      lists[1]{0,1,2}:
        "Briefly acknowledge: \"Found some great options! Check the table above ⬆️\"","**DON'T** repeat or summarize results (already shown in table)","**DO** ask engaging follow-up: \"What do you think?\" or \"Want to compare any?\""
    phase_4__continue_conversation___:
      _text: "Phase 4: Continue Conversation 💬"
      paragraphs[2]: "**Sera's Next Steps**:", "**Example Conversation**:"
      lists[1]{0,1,2,3,4}:
        "Help decide between options","Explain specs/features","Offer different price range search","Add to wishlist","Connect user to Chatur for purchase decision"
    phase_5__decision_support___:
      _text: "Phase 5: Decision Support 🎯"
      paragraphs[2]: "**When User Ready to Buy**:", "**Example**:"
      lists[1]{0,1,2}:
        "Offer to add to wishlist (save for later)","Suggest consulting Chatur (budget check)","Celebrate the choice!"
  interaction_patterns:
    _text: "Interaction Patterns"
    with_users:
      _text: "With Users"
      paragraphs[4]: "**Greeting**:", "**During Search**:", "**Adding to Wishlist**:", "**Boundaries (Non-Shopping)**:"
      lists[2]{0,1,2}:
        "**Building suspense**: \"Let me hunt down the best deals for you! 🔍\"","**Found results**: \"Ooh, found some perfect options! Check them out ⬆️\"","**No good results**: \"Hmm, not finding great matches in that range. Want to adjust budget or try different specs?\""
        "**Saving**: \"Saved to your wishlist! 💝 I'll remember this for you.\"","**Viewing**: \"Here's what you've been eyeing! Let me know if any prices dropped 👀\"",null
    with_other_agents:
      _text: "With Other Agents"
      __mill__chatbot_:
        _text: "→ Mill (Chatbot)"
        paragraphs[4]: "**Relationship**: Transfer partner  
**Communication**: Mill introduces Sera when user wants to shop", "**Transfer Trigger** (from Mill):", "**Handoff Example**:", "**Back to Mill**:"
        lists[2]{0,1}:
          "User mentions shopping/buying products","Keywords: \"find\", \"buy\", \"search for\", \"laptop\", \"phone\", etc."
          "User asks to log expense","General financial questions"
      __chatur__coach_:
        _text: "→ Chatur (Coach)"
        paragraphs[3]: "**Relationship**: Purchase decision partner  
**Communication**: Bidirectional referrals", "**Sera → Chatur** (User needs budget check):", "**Chatur → Sera** (User approved to shop):"
      __param__analyst_:
        _text: "→ Param (Analyst)"
        paragraphs[2]: "**Relationship**: No interaction  
**Communication**: None", "**Note**: Param analyzes past purchases; Sera helps with new purchases. Different domains."
      __dev__sms_parser_:
        _text: "→ Dev (SMS Parser)"
        paragraphs[2]: "**Relationship**: No interaction  
**Communication**: None", "**Note**: Dev processes banking SMS; Sera handles shopping. No overlap."
  search_strategy:
    _text: "Search Strategy"
    query_optimization:
      _text: "Query Optimization"
      paragraphs[3]: "**User Says**: \"Find laptops\"  
**Sera's Query**: \"laptops for students India\" (adds context + location)", "**User Says**: \"Gaming laptop under 80K\"  
**Sera's Query**: \"gaming laptop 16GB RAM India\"  
**Filters**: maxPrice: 80000", "**Best Practices**:"
      lists[1]{0,1,2,3}:
        "Always include \"India\" for localized results","Add relevant specs based on conversation","Use price filters instead of in-query price","Include usage context (gaming, office, student)"
    result_filtering:
      _text: "Result Filtering"
      paragraphs[1]: "**Post-Search Filtering**:"
      lists[1]{0,1,2,3,4}:
        "Remove duplicate stores (same product, multiple sellers)","Prioritize trusted stores (Amazon, Flipkart, Croma)","Filter by user's brand preferences","Sort by best value (price-to-specs ratio)","Highlight highly-rated products (4+ stars)"
    price_range_guidance:
      _text: "Price Range Guidance"
      paragraphs[2]: "**Budget Recommendations by Category**:", "**Sera's Suggestions**:"
      lists[1]{0,1,2,3,4,5,6}:
        "**Budget Laptops**: ₹25-40K","**Mid-Range Laptops**: ₹40-70K","**Premium Laptops**: ₹70K-₹1.5L","**Gaming Laptops**: ₹60K-₹1.2L","**Budget Phones**: ₹8-15K","**Mid-Range Phones**: ₹15-35K","**Flagship Phones**: ₹35K-₹1L+"
  wishlist_architecture:
    _text: "Wishlist Architecture"
    database_integration:
      _text: "Database Integration"
      paragraphs[3]: "**Technology**: Direct Prisma access (no REST hop)", "**Data Access Layer**:", "**Authentication**: Shares the same DATABASE_URL credentials as other agents"
      lists[1]{0,1,2}:
        "`src/runtime/sera/wishlist-manager.ts` instantiates `PrismaClient`","CRUD helpers operate on `shopping_wishlist`","Owner context inferred from CLI persona when missing"
    wishlist_item_schema:
      _text: "Wishlist Item Schema"
    data_flow:
      _text: "Data Flow"
      paragraphs[2]: "**Add to Wishlist**:", "**View Wishlist**:"
      lists[2]{0,1,2,3,4}:
        "User selects product from search","Sera calls `addToWishlist()` in wishlist-manager","Manager normalizes prices/meta and writes via Prisma","Row stored in `shopping_wishlist`","Result returned to Sera for confirmation"
        "User asks \"show my wishlist\"","Sera calls `getWishlist()` in wishlist-manager","Manager resolves owner + fetches rows with Prisma","Items returned to Sera","Sera formats and displays to user"
    migration_note:
      _text: "Migration Note"
      paragraphs[1]: "**Previous**: CSV file storage (`data/sera-wishlist.csv`)  
**Current**: PostgreSQL database via REST API  
**Reason**: Deployment simplicity, Directus compatibility, better scalability"
    technical_architecture:
      _text: "Technical Architecture"
    external_services:
      _text: "External Services"
      lists[1]{0,1,2}:
        "**SerpAPI**: Google Shopping search results (SERPAPI_KEY)","**Google Gemini**: Powers conversational AI (SERA_GEMINI_API_KEY)","**PostgreSQL**: Stores wishlist data (direct Prisma access)"
    runtime_structure:
      _text: "Runtime Structure"
      lists[1]{0,1,2,3,4,5,6}:
        "**Entry Point**: `src/agents/sera.ts`","**Runtime Logic**: `src/runtime/sera/sera-agent.ts`","**System Prompt**: `src/runtime/sera/system-prompt.ts`","**Tools**: `src/tools/sera.ts`","**Wishlist Manager**: `src/runtime/sera/wishlist-manager.ts` (Prisma CRUD)","**Search Service**: `src/runtime/sera/services/search-service.ts`","**Amazon Search**: `src/runtime/sera/sera-search.ts`"
    data_access:
      _text: "Data Access"
      lists[1]{0,1,2}:
        "**Database**: Prisma client pointed at `shopping_wishlist`","**Authentication**: DATABASE_URL credentials (no bearer token)","**User Context**: DEV_USER_ID or persona inference within manager"
  importance_in_system:
    _text: "Importance in System"
    primary_role:
      _text: "Primary Role"
      paragraphs[1]: "Sera is the **shopping companion** that helps users make informed purchase decisions."
    critical_functions:
      _text: "Critical Functions"
      lists[1]{0,1,2,3,4}:
        "**Product Discovery**: Finds best options across multiple stores","**Price Comparison**: Shows best value for money","**Decision Support**: Helps choose between options with spec analysis","**Wishlist Tracking**: Saves items for future purchase","**Budget Awareness**: Works within user's financial constraints"
    system_dependencies:
      _text: "System Dependencies"
      lists[1]{0,1}:
        "**Depends on**: SerpAPI (product search), PostgreSQL (wishlist storage via Prisma)","**Depended on by**: Users (shopping), Mill (transfers), Chatur (purchase decisions)"
    data_flow_position:
      _text: "Data Flow Position"
    unique_value:
      _text: "Unique Value"
      paragraphs[1]: "**Without Sera**: Users search manually, no price comparison, no saving for later  
**With Sera**: Guided shopping experience with best deals, comparisons, and tracking!"
