  new__financial_calculation_tools__chatur_:
    _text: "NEW: Financial Calculation Tools (Chatur)"
    overview:
      _text: Overview
      paragraphs[1]: "Chatur now includes **mathematically accurate financial calculators** that automatically trigger for calculation-based queries. These tools provide exact numbers that Chatur then translates into natural, actionable advice."
    calculation_types:
      _text: "Calculation Types"
      1__savings_goal_calculator:
        _text: "1. Savings Goal Calculator"
        paragraphs[5]: "**Triggers on**: \"save X per month\", \"reach X in Y months\", \"how much daily to save\"", "**Calculates**:", "**Example Query**: _\"How much should I save daily to reach ₹10,000 in 6 months?\"_", "**Calculation Output**:", "**Chatur's Natural Response**:"
        lists[1]{0,1,2}:
          "Daily, weekly, monthly savings requirements","Affordability check (% of income)","Recommended adjustments if unachievable"
      2__daily_budget_calculator:
        _text: "2. Daily Budget Calculator"
        paragraphs[5]: "**Triggers on**: \"how much can I spend daily\", \"daily budget\", \"spending limit per day\"", "**Calculates**:", "**Example Query**: _\"How much can I spend daily if I want to save ₹4,000 per month?\"_", "**Calculation Output**:", "**Chatur's Natural Response**:"
        lists[1]{0,1,2}:
          "Daily and weekly discretionary spending limits","Budget breakdown (income - fixed - savings)","Affordability warnings if too tight"
      3__budget_allocation__50_30_20_rule_:
        _text: "3. Budget Allocation (50/30/20 Rule)"
        paragraphs[5]: "**Triggers on**: \"how should I allocate\", \"budget breakdown\", \"divide my income\"", "**Calculates**:", "**Example Query**: _\"How should I divide my ₹25,000 monthly income?\"_", "**Calculation Output**:", "**Chatur's Natural Response**:"
        lists[1]{0,1,2,3}:
          "50% Needs (essentials)","30% Wants (lifestyle)","20% Savings (future)","Emergency fund targets (3-6 months)"
      4__affordability_check:
        _text: "4. Affordability Check"
        paragraphs[5]: "**Triggers on**: \"can I afford\", \"should I buy\", purchase decision queries", "**Calculates**:", "**Example Query**: _\"Can I afford to buy a ₹15,000 phone?\"_", "**Calculation Output**:", "**Chatur's Natural Response**:"
        lists[1]{0,1,2,3,4}:
          "% of monthly income","% of current savings","Emergency fund impact","Months to save if needed","Recommendation (buy_now / save_first / reconsider)"
    technical_implementation:
      _text: "Technical Implementation"
      paragraphs[4]: "**Module**: `src/tools/financial-calculator.ts`", "**Key Functions**:", "**Integration with Chatur**:", "**Example Flow**:"
      lists[1]{0,1,2,3}:
        "**Detection**: `needsFinancialCalculation(query)` checks if query needs math","**Extraction**: `extractCalculationParams(query, context)` parses amounts, timeframes","**Calculation**: `performCalculation(type, params)` runs exact math","**Natural Language**: Chatur receives calculations and explains in conversational tone"
    calculation_accuracy:
      _text: "Calculation Accuracy"
      paragraphs[3]: "✅ **Mathematically Precise**:", "✅ **Context-Aware**:", "✅ **Validated Output**:"
      lists[3]{0,1,2}:
        "All calculations use standard formulas","Rounding only for display (₹43.21 → ₹43)","Handles edge cases (negative savings, infinite debt payoff)"
        "Uses actual user data (income, expenses, savings)","Adjusts for irregular gig income patterns","Considers emergency fund requirements"
        "Test suite covers all calculation types","Edge cases tested (zero income, negative balance)","Comparison against financial calculators"
    test_calculations:
      _text: "Test Calculations"
      paragraphs[2]: "Run comprehensive tests:", "**Test Scenarios**:"
      lists[1]{0,1,2,3,4}:
        "Savings goal: ₹10,000 in 6 months → ₹43/day","Daily budget: Save ₹4,000/month → ₹200/day spending","Budget allocation: ₹25,000 income → 50/30/20 breakdown","Affordability: ₹15,000 phone → Save first (3 months)","Small goal: ₹200/month → ₹7/day (1.3% of income)"
  quick_commands:
    _text: "Quick Commands"
    test_financial_calculations:
      _text: "Test Financial Calculations"
