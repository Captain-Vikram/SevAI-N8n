# Local n8n defaults. Copy this file to .env to override them.
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/
GENERIC_TIMEZONE=Asia/Kolkata
TZ=Asia/Kolkata

# Google OAuth Credentials
GOOGLE_OAUTH_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your_client_secret_here
GOOGLE_OAUTH_REDIRECT_URI=https://your-ngrok-or-domain.dev/webhook/google-oauth-callback

# Local LM Studio Host (or other OpenAI-compatible endpoint)
LM_STUDIO_HOST=http://192.168.29.141:1234
