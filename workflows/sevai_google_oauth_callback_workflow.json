    {
      "parameters": {
        "jsCode": "let callback = {};\ntry {\n  callback = $('Validate OAuth State1').item.json;\n} catch (e) {\n  try {\n    callback = $('Validate OAuth State').item.json;\n  } catch (e2) {\n    callback = {};\n  }\n}\n\nconst targetState = String(callback.state || '').trim();\nif (!targetState) {\n  throw new Error('OAuth callback rejected: missing state parameter in callback');\n}\n\n// Extract chatId if state was encoded as chatId_token\nconst stateChatId = targetState.includes('_') ? targetState.split('_')[0] : null;\n\nconst rows = $input.all().map(item => item.json).filter(r => r && (r.state || r.chatId));\n\n// 1. First priority: exact state match\nlet matches = rows.filter(r => r.state && String(r.state).trim() === targetState);\n\n// 2. Second priority: match by chatId if state has chatId prefix\nif (matches.length === 0 && stateChatId) {\n  matches = rows.filter(r => r.chatId && String(r.chatId).trim() === stateChatId);\n}\n\nif (matches.length === 0) {\n  throw new Error('OAuth callback rejected: no pending registration found for state \"' + targetState + '\"');\n}\n\n// Pick the latest matched pending user\nconst pending = matches[matches.length - 1];\n\nreturn {\n  json: {\n    ...callback,\n    chatId: pending.chatId,\n    firstName: pending.firstName,\n    createdAt: pending.createdAt,\n    row_number: pending.row_number\n  }\n};"
      },
