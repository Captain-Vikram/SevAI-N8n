        "jsCode": "const query = $json.query || $json;\nif (query.error === 'access_denied') return [{json:{ok:false,statusCode:200,message:'Google authorization was cancelled. You can close this window and try again from Telegram.'}}];\nif (!query.state) throw new Error('OAuth callback rejected: missing state');\nif (!query.code) throw new Error('OAuth callback rejected: missing authorization code');\nreturn {json:{state:query.state,code:query.code}};"
