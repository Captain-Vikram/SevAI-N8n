    {
      "parameters": {
        "jsCode": "const allTxs = $input.all().map(item => item.json);\n\n// Get the last 30 transactions (to save context window space)\n// and reverse them so the newest are at the top\nconst recentTxs = allTxs.slice(-30).reverse();\n\nif (recentTxs.length === 0) {\n  return { json: { response: \"No past transactions found.\" } };\n}\n\n// Format them into a compact string to send back to the AI\nlet summaryString = \"Here are the user's most recent transactions:\\n\";\nrecentTxs.forEach(tx => {\n  summaryString += `- Date: ${tx.date || 'Unknown'}, Amount: ${tx.amount || 0}, Vendor: ${tx.vendor || 'Unknown'}, Category: ${tx.category || 'Unknown'}\\n`;\n});\n\nreturn { json: { response: summaryString } };"
      },
      "id": "0474c334-2e37-40f8-b1cd-a9117a54168e",
      "name": "Format Recent Transactions",
